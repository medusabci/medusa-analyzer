{
  "name": "RCG Feature Extraction",
  "experiment_path": "ecg_params",
  "biosignals": ["ECG"],
  "biosignal_information": ["fs", "n_chan"],
  "pipeline":
  [
    {
      "step": "Files",
      "path": "data_loader/files",
      "widget": "FilesWidget",
      "controller": "FilesController"
    },
    {
      "step": "Leads",
      "path": "ecg_features/leads",
      "widget": "LeadsWidget",
      "controller": "LeadsController"
    },
    {
      "step": "Preprocessing",
      "path": "ecg_features/preprocessing",
      "widget": "PreprocessingWidget",
      "controller": "PreprocessingController"
    },
    {
      "step": "Parameters",
      "path": "ecg_features/parameters",
      "widget": "ParametersWidget",
      "controller": "ParametersController"
    },
    {
      "step": "Save",
      "path": "ecg_features/save",
      "widget": "SaveWidget",
      "controller": "SaveController"
    }
  ]
}