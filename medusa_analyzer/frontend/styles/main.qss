/* Medusa Analyzer global design system - Dark Burgundy Theme */

QMainWindow, QWidget {
    background: #181215;
    color: #F7F1F3;
    font-family: "Segoe UI";
    font-size: 14px;
}

QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
    border: none;
}

QLabel#eyebrow {
    color: #E35A82;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#heroTitle {
    color: #FFF7FA;
    font-size: 39px;
    font-weight: 700;
}

QLabel#heroSubtitle {
    color: #C9B8C0;
    font-size: 18px;
}

QLabel#pageTitle {
    color: #FFF7FA;
    font-size: 27px;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: #F8EEF2;
    font-size: 20px;
    font-weight: 650;
}

QLabel#panelTitle,
QLabel#groupTitle,
QLabel#loadingTitle {
    color: #F2E5EA;
    font-size: 16px;
    font-weight: 650;
}

QLabel#subgroupTitle {
    color: #E7D7DE;
    font-size: 14px;
    font-weight: 650;
    margin-top: 8px;
}

QLabel#muted,
QLabel#metricLabel,
QLabel#summaryLabel {
    color: #B8A7AF;
}

QLabel#metricValue {
    color: #FFF7FA;
    font-size: 18px;
    font-weight: 650;
}

QLabel[role="table-drag-handle"] {
    color: #B8A7AF;
    font-weight: 700;
}

QFrame[role="surface-panel"],
QFrame[role="summary-section"],
QFrame[role="filter-controls"],
QFrame[role="feature-group"] {
    background: #22181D;
    border: 1px solid #3A2931;
    border-radius: 12px;
}

QTabWidget[role="features-tabs"] {
    background: transparent;
    border: none;
}

QTabWidget[role="features-tabs"]::pane {
    background: #22181D;
    border: 1px solid #3A2931;
    border-radius: 12px;
    top: -1px;
}

QTabWidget[role="features-tabs"] QTabBar::tab {
    color: #CDBCC4;
    background: #1F171B;
    border: 1px solid #3A2931;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    padding: 8px 14px;
    margin-right: 4px;
}

QTabWidget[role="features-tabs"] QTabBar::tab:hover {
    color: #FFD6E1;
    background: #2A1D23;
    border-color: #7A4055;
}

QTabWidget[role="features-tabs"] QTabBar::tab:selected {
    color: #FFF7FA;
    background: #A61E4D;
    border-color: #E35A82;
}

QFrame[role="feature-tab-page"] {
    background: transparent;
    border: none;
}

QFrame[role="plot-type-panel"] {
    background: #2A1D23;
    border: 1px solid #A61E4D;
    border-radius: 10px;
}

QLabel#plotTypeTitle {
    color: #FFF7FA;
    font-size: 16px;
    font-weight: 700;
}

QComboBox[role="plot-type-combo"] {
    min-height: 40px;
    color: #FFF7FA;
    background: #160F13;
    border: 2px solid #E35A82;
    font-weight: 650;
}

QComboBox[role="plot-type-combo"]:focus {
    border: 2px solid #39B8C1;
}

QFrame[role="plot-preview-panel"] {
    background: #22181D;
    border: 1px solid #3A2931;
    border-radius: 12px;
}

QPushButton[role="plot-export-button"] {
    min-width: 110px;
}

QTabWidget[role="plot-control-tabs"] {
    background: transparent;
    border: none;
}

QTabWidget[role="plot-control-tabs"]::pane {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
    top: -1px;
}

QTabWidget[role="plot-control-tabs"] QTabBar::tab {
    color: #B8A7AF;
    background: #181215;
    border: 1px solid #3E3036;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    min-height: 28px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget[role="plot-control-tabs"] QTabBar::tab:hover {
    color: #F8EEF2;
    background: #241A1F;
    border-color: #6A3142;
}

QTabWidget[role="plot-control-tabs"] QTabBar::tab:selected {
    color: #FFF7FA;
    background: #3A1D28;
    border-color: #A61E4D;
}

QFrame[role="editable-table"],
QFrame[role="table-header"] {
    background: transparent;
    border: none;
}

QFrame[role="table-header"] QLabel {
    color: #B8A7AF;
    font-size: 12px;
    font-weight: 650;
}

QLabel[role="error"] {
    color: #FFB6C2;
}

QLabel[role="warning"] {
    color: #F6C177;
}

QFrame#progressOverlay {
    qproperty-errorColor: #FFB6C2;
    qproperty-warningColor: #F6C177;
    background: rgba(8, 5, 7, 176);
}

QFrame#tutorialOverlay {
    background: rgba(8, 5, 7, 184);
}

QFrame#tutorialPanel {
    background: #22181D;
    border: 1px solid #7A4055;
    border-radius: 14px;
}

QLabel#tutorialTitle {
    color: #FF8FAE;
    font-size: 12px;
    font-weight: 750;
}

QLabel#tutorialCounter {
    min-height: 24px;
    padding: 0 10px;
    color: #9BE7E8;
    background: #173A3F;
    border: 1px solid #2E747A;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#tutorialStepTitle {
    color: #FFF7FA;
    font-size: 22px;
    font-weight: 730;
}

QLabel#tutorialBody,
QLabel#tutorialBullet {
    color: #D8C9D0;
}

QLabel#tutorialBullet {
    background: transparent;
    font-weight: 600;
}

QFrame[role="tutorial-example"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
}

QFrame[role="tutorial-example"][tone="positive"] {
    background: rgba(14, 124, 134, 24);
    border-color: rgba(94, 205, 214, 78);
}

QFrame[role="tutorial-example"][tone="warning"] {
    background: rgba(246, 193, 119, 18);
    border-color: rgba(246, 193, 119, 86);
}

QLabel#tutorialExampleTitle {
    color: #FFF7FA;
    font-weight: 700;
}

QLabel#tutorialExampleText {
    color: #CDBCC4;
    font-family: "Consolas";
    font-size: 12px;
}

QFrame#progressWindow {
    background: #261B21;
    border: 1px solid #7A4055;
    border-radius: 14px;
}

QLabel#progressWindowTitle {
    color: #FFF7FA;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#progressTitle {
    color: #EDE2E7;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QPushButton#progressCloseButton {
    min-height: 32px;
    padding: 0 14px;
}

QProgressBar#overlayProgressBar {
    min-height: 13px;
    max-height: 13px;
    background: #151014;
    border: 1px solid #42303B;
    border-radius: 6px;
}

QProgressBar#overlayProgressBar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #E35A82,
        stop: 1 #39B8C1
    );
    border-radius: 5px;
}

QTextEdit#progressLogArea {
    color: #F4E9ED;
    background: #171115;
    border: 1px solid #443139;
    border-radius: 8px;
    padding: 8px;
}

/* Dashboard */
QScrollArea#dashboardPage,
QWidget#dashboard {
    background: #181215;
}

QWidget#dashboard QLabel,
QWidget#dashboard QWidget#dashboardContainer,
QWidget#dashboard QWidget#moduleGrid,
QWidget#moduleCardShell {
    background: transparent;
}

QFrame#dashboardHero {
    background: transparent;
    border: none;
}

QLabel#dashboardEyebrow {
    color: #E35A82;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 2px;
}

QLabel#dashboardHeroTitle {
    color: #FFF7FA;
    font-size: 38px;
    font-weight: 750;
}

QFrame#dashboardHero[compact="true"] QLabel#dashboardHeroTitle {
    font-size: 30px;
}

QLabel#dashboardHeroSubtitle {
    color: #C6B5BD;
    font-size: 17px;
}

QLabel#heroChip {
    min-height: 27px;
    padding: 0 12px;
    border-radius: 13px;
    font-size: 11px;
    font-weight: 650;
}

QLabel#heroChip[tone="burgundy"] {
    color: #FFB7C9;
    background: rgba(227, 90, 130, 38);
    border: 1px solid rgba(227, 90, 130, 85);
}

QLabel#heroChip[tone="teal"] {
    color: #8FE3E8;
    background: rgba(14, 124, 134, 48);
    border: 1px solid rgba(94, 205, 214, 85);
}

QFrame#moduleSection {
    background: rgba(34, 24, 29, 210);
    border: 1px solid #3B2A32;
    border-radius: 22px;
}

QLabel#moduleSectionTitle {
    color: #FFF7FA;
    font-size: 23px;
    font-weight: 720;
}

QLabel#moduleSectionSubtitle {
    color: #BFAEB6;
    font-size: 14px;
}

QFrame#moduleCard {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #2A1D23,
        stop: 0.65 #24191E,
        stop: 1 #351A24
    );
    border: 1px solid #4A3039;
    border-radius: 22px;
}

QFrame#moduleCard[hovered="true"],
QFrame#moduleCard[focused="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #33232A,
        stop: 0.58 #2B1D23,
        stop: 1 #4A2030
    );
    border: 1px solid #B94A68;
}

QFrame#moduleCard[focused="true"] {
    border: 2px solid #39B8C1;
}

QFrame#moduleCard[enabled="false"] {
    background: #211A1D;
    border: 1px dashed #4A3B41;
}

QLabel#moduleBadge {
    min-height: 24px;
    padding: 0 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.5px;
}

QLabel#moduleBadge[status="ready"] {
    color: #9BE7E8;
    background: #173A3F;
    border: 1px solid #2E747A;
}

QLabel#moduleBadge[status="soon"] {
    color: #B4AAB0;
    background: #2B2528;
    border: 1px solid #4A4045;
}

QLabel#moduleIcon {
    color: #FF91AD;
    background: #3B1D27;
    border: 1px solid #6A3142;
    border-radius: 63px;
    font-size: 18px;
    font-weight: 800;
}

QLabel#moduleTitle {
    color: #FFF7FA;
    font-size: 27px;
    font-weight: 760;
}

QFrame#moduleAccent {
    background: #E35A82;
    border: none;
    border-radius: 1px;
}

QLabel#moduleDescription {
    color: #C1B0B8;
    font-size: 14px;
}

QLabel#moduleHint {
    color: #FF8FAE;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 1.4px;
}

QFrame#moduleCard[enabled="false"] QLabel {
    color: #81767B;
}

QPushButton {
    min-height: 38px;
    padding: 0 18px;
    border-radius: 9px;
    font-weight: 600;
}

QPushButton[variant="primary"] {
    color: #FFF7FA;
    background: #A61E4D;
    border: 1px solid #C83B67;
}

QPushButton[variant="primary"]:hover {
    background: #C0275B;
    border-color: #E35A82;
}

QPushButton[variant="secondary"] {
    color: #FFB0C4;
    background: #321B24;
    border: 1px solid #734052;
}

QPushButton[variant="secondary"]:hover {
    background: #432330;
    border-color: #A94D68;
}

QPushButton[variant="ghost"] {
    color: #C5B7BE;
    background: transparent;
    border: 1px solid transparent;
}

QPushButton[variant="ghost"]:hover {
    color: #FF9DB7;
    background: #2A1D23;
    border: 1px solid #443139;
}

QPushButton:disabled {
    color: #756B70;
    background: #2A2528;
    border-color: #2A2528;
}

QPushButton[role="segmentation-mode-button"],
QPushButton[role="segmentation-target-button"],
QPushButton[role="segmentation-strategy-button"] {
    color: #D7C8CF;
    background: #241A1F;
    border: 1px solid #4A3A42;
    border-radius: 8px;
}

QPushButton[role="segmentation-mode-button"]:hover,
QPushButton[role="segmentation-target-button"]:hover,
QPushButton[role="segmentation-strategy-button"]:hover {
    color: #FFD6E1;
    background: #321B24;
    border-color: #A94D68;
}

QPushButton[role="segmentation-mode-button"]:checked,
QPushButton[role="segmentation-target-button"]:checked,
QPushButton[role="segmentation-strategy-button"]:checked {
    color: #FFF7FA;
    background: #A61E4D;
    border: 1px solid #E35A82;
}

QPushButton[role="segmentation-mode-button"]:checked:hover,
QPushButton[role="segmentation-target-button"]:checked:hover,
QPushButton[role="segmentation-strategy-button"]:checked:hover {
    background: #C0275B;
    border-color: #FF8FAE;
}

QPushButton[role="segmentation-mode-button"]:disabled,
QPushButton[role="segmentation-target-button"]:disabled,
QPushButton[role="segmentation-strategy-button"]:disabled {
    color: #756B70;
    background: #2A2528;
    border-color: #332A2E;
}

QPushButton[role="segmentation-duration-action"] {
    color: #FFB0C4;
    background: #321B24;
    border: 1px solid #734052;
    border-radius: 8px;
}

QPushButton[role="segmentation-duration-action"]:hover {
    color: #FFD6E1;
    background: #432330;
    border-color: #A94D68;
}

QPushButton[role="segmentation-duration-action"]:pressed {
    background: #2A1720;
}

QPushButton[role="segmentation-instant-action"] {
    color: #9BE7E8;
    background: #173A3F;
    border: 1px solid #2E747A;
    border-radius: 8px;
}

QPushButton[role="segmentation-instant-action"]:hover {
    color: #D7FDFF;
    background: #1D4A50;
    border-color: #5ECDD6;
}

QPushButton[role="segmentation-instant-action"]:pressed {
    background: #12373C;
}

QPushButton[role="segmentation-duration-action"]:disabled,
QPushButton[role="segmentation-instant-action"]:disabled {
    color: #756B70;
    background: #2A2528;
    border-color: #332A2E;
}

QFrame[role="segmentation-target-panel"] {
    background: #1F171B;
    border: 1px solid #4A3A42;
    border-radius: 9px;
}

QLabel#segmentationTargetLabel {
    color: #D7C8CF;
    font-weight: 650;
}

QWidget[role="nested-group-editor"],
QFrame[role="nested-group-editor"] {
    background: transparent;
    border: none;
}

QFrame[role="nested-base-event"] {
    background: rgba(227, 90, 130, 38);
    border: 1px solid rgba(227, 90, 130, 124);
    border-radius: 11px;
}

QFrame[role="nested-base-event"] QLabel {
    background: transparent;
}

QLabel#nestedBaseEventTitle {
    color: #FFD6E1;
    font-weight: 700;
}

QFrame[role="nested-contained-events"] {
    background: transparent;
    border: none;
}

QFrame[role="segmentation-visual-widget"] {
    background: #1F171B;
    border: 1px solid #3A2931;
    border-radius: 10px;
}

QFrame[role="segmentation-visual-control"] {
    background: #241A1F;
    border: 1px solid #3E3036;
    border-radius: 8px;
}

QLabel#segmentationVisualBadge {
    min-width: 72px;
    min-height: 25px;
    padding: 0 10px;
    color: #FFF7FA;
    background: #181215;
    border: 1px solid #4A3A41;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 650;
}

QLabel#segmentationVisualBadge[status="error"] {
    color: #FFB6C2;
    background: #2A171D;
    border-color: #C85663;
}

QSpinBox[status="error"] {
    color: #FFB6C2;
    background: #2A171D;
    border-color: #C85663;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #181215;
    border: 1px solid #3E3036;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 17px;
    height: 17px;
    margin: -7px 0;
    border-radius: 8px;
    background: #E35A82;
    border: 1px solid #FF9DB7;
}

QSlider::sub-page:horizontal {
    background: #A61E4D;
    border-radius: 3px;
}

QLineEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    min-height: 34px;
    padding: 0 9px;
    color: #F8EEF2;
    background: #120D10;
    border: 1px solid #4A3A41;
    border-radius: 7px;
    selection-background-color: #A61E4D;
}

QLineEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid #39B8C1;
}

QSpinBox,
QDoubleSpinBox {
    padding-right: 24px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 17px;
    border-left: 1px solid #4A3A41;
    border-top-right-radius: 7px;
    background: #181215;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 17px;
    border-left: 1px solid #4A3A41;
    border-top: 1px solid #2A1D23;
    border-bottom-right-radius: 7px;
    background: #181215;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #22181D;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: #2A1D23;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(${STYLE_DIR}/icons/spin_up.xpm);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(${STYLE_DIR}/icons/spin_down.xpm);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url(${STYLE_DIR}/icons/spin_up.xpm);
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url(${STYLE_DIR}/icons/spin_down.xpm);
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    color: #F8EEF2;
    background: #1F171B;
    border: 1px solid #4A3A41;
    selection-background-color: #A61E4D;
    selection-color: #FFF7FA;
    outline: none;
}

QCheckBox {
    spacing: 9px;
    color: #F1E5EA;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #6E5A63;
    border-radius: 5px;
    background: #120D10;
}

QCheckBox::indicator:checked {
    background: #A61E4D;
    border-color: #E35A82;
    image: none;
}

QCheckBox#controlTitle {
    font-size: 16px;
    font-weight: 650;
}

QFrame[role="analysis-mode-option"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
}

QFrame[role="analysis-mode-option"][selected="true"] {
    background: #2A1D23;
    border: 1px solid #E35A82;
}

QRadioButton[role="analysis-mode-radio"] {
    spacing: 9px;
    color: #F8EEF2;
    font-weight: 650;
}

QRadioButton[role="analysis-mode-radio"]::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #6E5A63;
    border-radius: 9px;
    background: #120D10;
}

QRadioButton[role="analysis-mode-radio"]::indicator:checked {
    background: #A61E4D;
    border: 2px solid #FF9DB7;
}

QLabel#analysisModeDescription {
    color: #B8A7AF;
}

QFrame[role="group-definition-chip"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 10px;
}

QFrame[role="group-definition-chip"]:hover {
    background: #241A1F;
    border-color: #6A3142;
}

QWidget[role="group-color-swatch"] {
    background: transparent;
}

QPushButton[role="group-color-button"] {
    min-width: 88px;
}

QTableWidget[role="assignment-table"] {
    color: #F4E9ED;
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
    gridline-color: #3E3036;
    outline: none;
}

QTableWidget[role="assignment-table"] QHeaderView::section {
    color: #B8A7AF;
    background: #241A1F;
    border: none;
    border-right: 1px solid #3E3036;
    border-bottom: 1px solid #3E3036;
    padding: 7px 9px;
    font-weight: 650;
}

QTableWidget[role="assignment-table"]::item {
    padding: 7px;
    border: none;
}

QTableWidget[role="assignment-table"]::item:selected {
    color: #FFD6E1;
    background: #4A2030;
}

QLabel#assignmentInstruction {
    color: #B8A7AF;
}

QLabel#assignmentSummary {
    color: #F8EEF2;
    background: #241A1F;
    border: 1px solid #3E3036;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 650;
}

QListWidget[role="file-list"] {
    color: #F4E9ED;
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 7px;
    border-radius: 5px;
}

QListWidget::item:selected {
    color: #FFD6E1;
    background: #4A2030;
}

QListWidget#durationEventsList::item:selected {
    color: #FFD6E1;
    background: rgba(227, 90, 130, 28);
    border: 1px solid rgba(227, 90, 130, 92);
}

QListWidget#instantEventsList::item:selected {
    color: #9BE7E8;
    background: rgba(14, 124, 134, 24);
    border: 1px solid rgba(94, 205, 214, 78);
}

QWidget[role="token-chip-area"],
QWidget[role="entity-chip-area"] {
    background: transparent;
    border: none;
}

QFrame[role="mapping-token-chip"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
}

QFrame[role="mapping-token-chip"][assigned="true"] {
    background: rgba(14, 124, 134, 24);
    border-color: rgba(94, 205, 214, 94);
}

QFrame[role="mapping-token-chip"][custom="true"] {
    background: rgba(227, 90, 130, 24);
    border-color: rgba(227, 90, 130, 84);
}

QFrame[role="mapping-token-chip"]:hover,
QFrame[role="mapping-token-chip"]:focus {
    background: #2A1D23;
    border: 1px solid #39B8C1;
}

QFrame[role="mapping-token-chip"] QLabel,
QFrame[role="mapping-assignment-chip"] QLabel {
    background: transparent;
}

QLabel[role="token-prefix"] {
    color: #B8A7AF;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="token-text"] {
    color: #FFF7FA;
    font-weight: 650;
}

QLabel[role="token-state"] {
    color: #81767B;
    font-size: 12px;
    font-weight: 650;
}

QLabel[role="token-state"][assigned="true"] {
    color: #9BE7E8;
}

QFrame[role="mapping-entity-row"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
}

QLabel#mappingEntityName {
    color: #FFF7FA;
    font-size: 15px;
    font-weight: 700;
}

QLabel[role="entity-badge"] {
    min-height: 22px;
    padding: 0 9px;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[role="entity-badge"][required="true"] {
    color: #FFD6E1;
    background: rgba(227, 90, 130, 28);
    border: 1px solid rgba(227, 90, 130, 92);
}

QLabel[role="entity-badge"][required="false"] {
    color: #9BE7E8;
    background: rgba(14, 124, 134, 24);
    border: 1px solid rgba(94, 205, 214, 78);
}

QFrame[role="mapping-assignment-chip"] {
    background: #241A1F;
    border: 1px solid #4A3A42;
    border-radius: 8px;
}

QFrame[role="mapping-assignment-chip"]:hover,
QFrame[role="mapping-assignment-chip"]:focus {
    border: 1px solid #39B8C1;
}

QFrame[role="mapping-assignment-chip"] QLabel {
    color: #F8EEF2;
    font-weight: 600;
}

QFrame[role="conversion-summary"] {
    background: #1F171B;
    border: 1px solid #3E3036;
    border-radius: 9px;
}

QLabel[role="conversion-step-title"] {
    color: #B8A7AF;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="conversion-step-value"] {
    color: #F8EEF2;
    font-weight: 600;
}

QFrame#summaryDurationChip {
    background: rgba(227, 90, 130, 28);
    border: 1px solid rgba(227, 90, 130, 92);
    border-radius: 9px;
}

QFrame#summaryDurationChip QLabel,
QFrame#summaryDurationChip QPushButton {
    background: transparent;
    border: none;
    color: #FFD6E1;
    font-weight: 650;
}

QFrame#summaryDurationChip[compact="true"] {
    background: rgba(227, 90, 130, 20);
    border: 1px solid rgba(227, 90, 130, 70);
    border-radius: 7px;
}

QFrame#summaryDurationChip[compact="true"] QLabel,
QFrame#summaryDurationChip[compact="true"] QPushButton {
    color: #FFD6E1;
    font-size: 12px;
    font-weight: 600;
}

QFrame#summaryBaseDurationChip {
    background: rgba(227, 90, 130, 42);
    border: 1px solid rgba(227, 90, 130, 118);
    border-radius: 9px;
}

QFrame#summaryBaseDurationChip QLabel,
QFrame#summaryBaseDurationChip QPushButton {
    background: transparent;
    border: none;
    color: #FFD6E1;
    font-weight: 700;
}

QFrame#summaryInstantChip {
    background: rgba(14, 124, 134, 24);
    border: 1px solid rgba(94, 205, 214, 78);
    border-radius: 9px;
}

QFrame#summaryInstantChip QLabel,
QFrame#summaryInstantChip QPushButton {
    background: transparent;
    border: none;
    color: #9BE7E8;
    font-weight: 600;
}

QFrame#summaryInstantChip[compact="true"] {
    background: rgba(14, 124, 134, 18);
    border: 1px solid rgba(94, 205, 214, 66);
    border-radius: 7px;
}

QFrame#summaryInstantChip[compact="true"] QLabel,
QFrame#summaryInstantChip[compact="true"] QPushButton {
    color: #9BE7E8;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#chipRemoveButton {
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    border-radius: 8px;
    border: 1px solid rgba(248, 238, 242, 88);
    background: rgba(18, 13, 16, 150);
    color: #F8EEF2;
    font-size: 10px;
    font-weight: 700;
}

QPushButton#chipRemoveButton:hover {
    background: rgba(248, 238, 242, 38);
    border-color: rgba(248, 238, 242, 150);
}

QFrame[role="band-chip"] {
    background: #241A1F;
    border: 1px solid #3C2D34;
    border-radius: 9px;
}

QFrame[role="plot"] {
    background: #120D10;
    border: 1px solid #3C3035;
    border-radius: 8px;
    qproperty-plotBackgroundColor: #181215;
    qproperty-gridColor: #3A2931;
    qproperty-axisLineColor: #6E5A63;
    qproperty-axisTextColor: #C9B8C0;
    qproperty-responseLineColor: #E35A82;
    qproperty-emptyMessageColor: #C9B8C0;
}

QLabel#selectionStatus {
    padding: 10px 13px;
    border-radius: 7px;
    color: #9BE7E8;
    background: #173A3F;
}

QLabel#selectionStatus[status="error"] {
    color: #FFB6C2;
    background: #491B27;
}

QLabel#selectionStatus[status="ready"] {
    color: #9BE7E8;
    background: #173A3F;
}

QFrame#loadingOverlay {
    background: rgba(8, 5, 7, 180);
}

QFrame[role="loading-panel"] {
    background: #22181D;
    border: 1px solid #4A3039;
    border-radius: 14px;
}

QProgressBar {
    min-height: 9px;
    max-height: 9px;
    color: transparent;
    background: #35272E;
    border: none;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background: #E35A82;
    border-radius: 4px;
}

QWidget[role="step-progress"] {
    qproperty-lineColor: #DDD7D8;
    qproperty-lockedStepColor: #C9C4C7;
    qproperty-activeStepColor: #8A1538;
    qproperty-completedStepColor: #8A1538;
    qproperty-errorStepColor: #C85663;
    qproperty-numberColor: #FFFFFF;
    qproperty-lockedLabelColor: #FFFFFF;
    qproperty-activeLabelColor: #E35A82;
    qproperty-completedLabelColor: #FFFFFF;
    qproperty-errorLabelColor: #FFFFFF;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #3E3036;
}

QToolTip {
    color: #FFF7FA;
    background: #2A1D23;
    border: 1px solid #6A3142;
    padding: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #5A4850;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7A5C68;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QFrame#dashboardHero {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #2A1D23,
        stop: 0.55 #22181D,
        stop: 1 #3A1826
    );
    border: 1px solid #4A3039;
    border-radius: 24px;
}

QLabel#dashboardEyebrow,
QLabel#dashboardHeroTitle,
QLabel#dashboardHeroSubtitle,
QLabel#heroChip {
    background: transparent;
}

QLabel#dashboardEyebrow {
    color: #FF8FAE;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 2px;
}

QLabel#dashboardHeroTitle {
    color: #FFF7FA;
    font-size: 38px;
    font-weight: 750;
}

QFrame#dashboardHero[compact="true"] QLabel#dashboardHeroTitle {
    font-size: 30px;
}

QLabel#dashboardHeroSubtitle {
    color: #CDBBC3;
    font-size: 17px;
}

QLabel#heroChip[tone="burgundy"] {
    color: #FFB7C9;
    background: rgba(227, 90, 130, 38);
    border: 1px solid rgba(227, 90, 130, 85);
}

QLabel#heroChip[tone="teal"] {
    color: #8FE3E8;
    background: rgba(14, 124, 134, 48);
    border: 1px solid rgba(94, 205, 214, 85);
}
